#!/usr/bin/env bash
# The gate a task must pass before it is finished (TASK-302; see CLAUDE.md,
# "Finishing a task", for which of the two a change needs).
#
# Usage:
#   bin/gate                # full gate: bin/lint and every test (bin/test)
#   bin/gate --fast [NS...] # fast gate: bin/lint and every test not tagged
#                           # ^:slow, plus -- in full -- the test namespaces
#                           # this change touches and any NS... named
#
# "The namespaces this change touches", for --fast, are read from the working
# tree against HEAD (staged, unstaged and untracked): every changed or new
# file under test/ that declares a namespace, and for every changed file
# under src/ (or dev/), the test namespace named after it -- src/a/b.clj ->
# a.b-test -- when one exists. A changed test helper (a file under test/ with
# no deftest) brings in every test namespace that names it. Pass more
# namespaces explicitly when a change reaches further than that (a resource
# file, a function many namespaces call).
#
# `--dry-run` prints what would run (the namespaces taken in full, the plan)
# and runs nothing.
#
# Lint runs alongside the tests, and both always run to the end, so one gate
# run reports everything; the exit status is non-zero if either failed.
set -uo pipefail
cd "$(dirname "$0")/.."

fast=0
dry=0
named=()
for arg in "$@"; do
  case "$arg" in
    --fast) fast=1 ;;
    --dry-run) dry=1 ;;
    -h | --help)
      sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    -*)
      echo "bin/gate: unknown option $arg (see --help)" >&2
      exit 2
      ;;
    *) named+=("$arg") ;;
  esac
done
if [ "$fast" -eq 0 ] && [ "${#named[@]}" -gt 0 ]; then
  echo "bin/gate: namespaces only go with --fast; the full gate runs everything" >&2
  exit 2
fi

# The ns name declared by a .clj file, if any.
ns_of() {
  awk '/^\(ns[ \t]/ { for (i = 2; i <= NF; i++) if ($i !~ /^\^/) { gsub(/\)/, "", $i); print $i; exit } }' "$1"
}

touched=()
if [ "$fast" -eq 1 ]; then
  while IFS= read -r file; do
    case "$file" in
      test/*.clj)
        [ -f "$file" ] || continue
        ns=$(ns_of "$file")
        [ -n "$ns" ] || continue
        touched+=("$ns")
        # A shared test helper (no deftest of its own): the namespaces
        # that use it are what its change can break.
        if ! grep -q '^(deftest' "$file"; then
          while IFS= read -r user; do
            u=$(ns_of "$user")
            [ -n "$u" ] && touched+=("$u")
          done < <(grep -rlF --include='*.clj' "$ns" test)
        fi
        ;;
      src/*.clj | dev/*.clj)
        rel="${file#*/}"
        candidate="test/${rel%.clj}_test.clj"
        [ -f "$candidate" ] && ns=$(ns_of "$candidate") && [ -n "$ns" ] && touched+=("$ns")
        ;;
    esac
  done < <({
    git diff --name-only HEAD --
    git ls-files --others --exclude-standard
  } | sort -u)
fi

if [ "$fast" -eq 1 ]; then
  mapfile -t full < <(printf '%s\n' "${touched[@]}" "${named[@]}" | sed '/^$/d' | sort -u)
else
  full=()
fi

if [ "$dry" -eq 1 ]; then
  [ "${#full[@]}" -gt 0 ] && echo "run in full: ${full[*]}"
  if [ "$fast" -eq 1 ]; then
    exec ./bin/test --dry-run --fast "${full[@]}"
  fi
  exec ./bin/test --dry-run
fi

status=0
started=$SECONDS

# Lint and the tests each in a process group of their own (job control), so
# an interrupted gate stops both: bin/test, signalled, stops its own JVMs.
set -m
lint_pid=""
test_pid=""
finished=0
stop_all() {
  [ "$finished" -eq 1 ] && return 0
  [ -n "$test_pid" ] && kill -TERM "$test_pid" 2>/dev/null
  [ -n "$lint_pid" ] && kill -TERM -- "-$lint_pid" 2>/dev/null
}
trap 'stop_all; echo "bin/gate: interrupted" >&2; exit 130' INT
trap 'stop_all; echo "bin/gate: terminated" >&2; exit 143' TERM
trap 'stop_all; rm -f "${lint_log:-}"' EXIT

# Lint (~3 min, mostly cljfmt's JVM) runs alongside the tests rather than
# before them; its output is printed once the tests are done.
lint_log=$(mktemp /tmp/haselnuss-lint.XXXXXX)
./bin/lint >"$lint_log" 2>&1 &
lint_pid=$!

echo "== tests =="
if [ "$fast" -eq 1 ]; then
  if [ "${#full[@]}" -gt 0 ]; then
    echo "run in full: ${full[*]}"
  fi
  ./bin/test --fast "${full[@]}" &
else
  ./bin/test &
fi
test_pid=$!
wait "$test_pid" || status=1

echo
echo "== lint =="
wait "$lint_pid" || status=1
finished=1
cat "$lint_log"

echo
if [ "$status" -eq 0 ]; then
  echo "bin/gate: $([ "$fast" -eq 1 ] && echo fast || echo full) gate passed in $((SECONDS - started)) s"
else
  echo "bin/gate: $([ "$fast" -eq 1 ] && echo fast || echo full) gate FAILED after $((SECONDS - started)) s"
fi
exit "$status"
